{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pass-the-host-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "ratelimits": [
    { "name": "SIGNUP_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "JOIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "passthehost-db",
      "database_id": "1f859cdc-b97b-4043-ab04-cd3373f7b7e2",
      "migrations_dir": "migrations"
    }
  ]
}
